# Normalise line endings.
#
# Without this, files committed from the Linux sandbox come back as modified
# the moment a Windows editor touches them — a diff of 6,000 lines that
# changes nothing. LF in the repository, whatever the checkout looks like.
* text=auto eol=lf

# Binary assets, left alone.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.m4a binary
*.mp3 binary
*.wav binary
