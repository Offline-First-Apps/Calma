{
  "expo": {
    "name": "Calma",
    "slug": "calma",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "calma",
    "userInterfaceStyle": "automatic",
    "owner": "codewithkin",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "app.calma.mobile",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/ios-icon-light.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "com.codewithkin.calma",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-localization",
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Calma uses Face ID so only you can open your writing."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E39A45"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F1",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#141C26"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f74cd574-565e-4cf4-88e8-9adbbdba54d3"
      }
    }
  }
}
